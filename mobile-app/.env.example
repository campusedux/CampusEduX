# Copy to .env and fill in from Supabase Dashboard → Project Settings → API keys.
# Only client-safe (publishable / anon) keys belong in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Secrets for the payment Edge Functions.
# Local:   copy to supabase/functions/.env  (git-ignored) for `supabase functions serve`
# Deployed: `supabase secrets set --env-file supabase/functions/.env`
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected by
# the platform automatically and must NOT be set here.

# Razorpay API keys — Dashboard -> Settings -> API Keys. Use the rzp_test_* pair
# for development. RAZORPAY_KEY_SECRET is server-only and is never returned to
# the client.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Same Supabase project as the mobile app (mobile-app/.env).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public origin of this admin panel, used to build the password-reset redirect
# link (e.g. http://localhost:3000 in dev, https://admin.campusedux.app in prod).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: this build uses NO service-role key. Every query runs as the signed-in
# admin's own session; writes are authorised by the is_admin() RLS policies in
# admin-panel/supabase/migrations/002_admin_rls_policies.sql, and the few
# transactional money moves go through SECURITY DEFINER functions.

{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm test*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npx tsc*)",
      "Bash(npx eslint*)",
      "Bash(npx jest*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout -b*)",
      "Bash(git switch -c*)",
      "Bash(git branch *)",
      "mcp__github"
    ],
    "additionalDirectories": [
      "/home/ganeshp8545/CampusEduX/mobile-app/tests/unit/legal"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|Read",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/security-gate.cjs\"",
            "timeout": 130,
            "statusMessage": "Applying CampusEduX safety checks"
          }
        ]
      }
    ]
  }
}

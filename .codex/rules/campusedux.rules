# Durable restrictions only; no historical command allowlist.
# These rules govern command execution approvals and are not a complete sandbox.
# Unmatched commands are not implicitly authorized. Root AGENTS.md still applies.

prefix_rule(
    pattern = ["rm",["-rf","-fr"],["/","~","~/",".","./",".git","/home/ganeshp8545","/home/ganeshp8545/","/home/ganeshp8545/CampusEduX","/home/ganeshp8545/CampusEduX/"]],
    decision = "forbidden",
    justification = "Deleting the repository, home directory, Git metadata, or filesystem root is forbidden.",
    match = ["rm -rf /","rm -rf .","rm -fr .git"],
)

prefix_rule(
    pattern = ["vercel",["rm","remove","delete"]],
    decision = "forbidden",
    justification = "Deleting production hosting resources is forbidden.",
    match = ["vercel rm example"],
)

prefix_rule(
    pattern = ["vercel","project","rm"],
    decision = "forbidden",
    justification = "Deleting a hosting project is forbidden.",
    match = ["vercel project rm example"],
)

prefix_rule(
    pattern = ["supabase","projects","delete"],
    decision = "forbidden",
    justification = "Deleting a Supabase project is forbidden.",
    match = ["supabase projects delete example"],
)

prefix_rule(
    pattern = ["git","push"],
    decision = "forbidden",
    justification = "CampusEduX never pushes; commit approval does not authorize a push.",
    match = ["git push","git push origin HEAD","git push --force"],
)

prefix_rule(
    pattern = ["supabase","db","push"],
    decision = "forbidden",
    justification = "The user runs Supabase db push; agents must not apply remote migrations.",
    match = ["supabase db push"],
)

prefix_rule(
    pattern = ["npx","supabase","db","push"],
    decision = "forbidden",
    justification = "The user runs Supabase db push; agents must not apply remote migrations.",
    match = ["npx supabase db push"],
)

prefix_rule(
    pattern = ["gh","auth","token"],
    decision = "forbidden",
    justification = "Printing authentication tokens is forbidden.",
    match = ["gh auth token"],
)

prefix_rule(
    pattern = ["supabase","projects","api-keys"],
    decision = "forbidden",
    justification = "Printing project credentials is forbidden.",
    match = ["supabase projects api-keys"],
)

prefix_rule(
    pattern = ["gh","repo","delete"],
    decision = "forbidden",
    justification = "Repository deletion is forbidden.",
    match = ["gh repo delete"],
)

prefix_rule(
    pattern = ["terraform","destroy"],
    decision = "forbidden",
    justification = "Infrastructure destruction is forbidden.",
    match = ["terraform destroy"],
)

prefix_rule(
    pattern = ["pulumi","destroy"],
    decision = "forbidden",
    justification = "Infrastructure destruction is forbidden.",
    match = ["pulumi destroy"],
)

prefix_rule(
    pattern = ["git",["filter-branch","filter-repo"]],
    decision = "forbidden",
    justification = "Destructive history rewriting is forbidden.",
    match = ["git filter-branch","git filter-repo"],
)

prefix_rule(
    pattern = ["git","reflog","expire"],
    decision = "forbidden",
    justification = "Destroying recovery history is forbidden.",
    match = ["git reflog expire"],
)

prefix_rule(
    pattern = ["git","update-ref","-d"],
    decision = "forbidden",
    justification = "Deleting Git references is forbidden.",
    match = ["git update-ref -d refs/heads/example"],
)

prefix_rule(
    pattern = ["git",["commit","merge","rebase","reset","clean","restore","rm","tag","cherry-pick","revert","stash","branch","checkout","switch","remote","config"]],
    decision = "prompt",
    justification = "Git mutations require explicit human approval; never overwrite unrelated work.",
    match = ["git commit -m example","git switch -c example","git reset --hard"],
)

prefix_rule(
    pattern = ["git",["-C","-c","--git-dir","--work-tree"]],
    decision = "prompt",
    justification = "Review option-prefixed Git commands; never use options to bypass the Never Push rule.",
    match = ["git -C . status","git -c core.editor=true commit"],
)

prefix_rule(
    pattern = [["psql","pg_dump","pg_restore","createdb","dropdb","supabase","vercel","netlify","eas","gh"]],
    decision = "prompt",
    justification = "Database, hosting, publication, and privileged service commands require explicit approval.",
    match = ["psql --version","supabase db reset","gh pr create"],
)

prefix_rule(
    pattern = [["node","python","python3","bash","sh","eval","env","xargs","sudo","powershell","pwsh","npx","corepack"]],
    decision = "prompt",
    justification = "Review interpreter or wrapper commands rather than importing historical blanket allowances.",
    match = ["python3 -c pass","bash script.sh"],
)

prefix_rule(
    pattern = [["rm","rmdir","unlink","shred","truncate","find","kill","pkill","killall","service"]],
    decision = "prompt",
    justification = "Deletion, cleanup, process control, and services require explicit human approval.",
    match = ["rm example.txt","find . -delete"],
)

prefix_rule(
    pattern = [["curl","wget"]],
    decision = "prompt",
    justification = "Review network requests for credentials, mutations, and production access.",
    match = ["curl https://example.invalid"],
)

prefix_rule(
    pattern = ["npm",["install","i","uninstall","publish"]],
    decision = "prompt",
    justification = "Installing, removing, or publishing packages requires explicit human approval.",
    match = ["npm install example"],
)

prefix_rule(
    pattern = ["pnpm",["add","install","remove","publish"]],
    decision = "prompt",
    justification = "Installing, removing, or publishing packages requires explicit human approval.",
    match = ["pnpm add example"],
)

prefix_rule(
    pattern = ["yarn",["add","install","remove","publish"]],
    decision = "prompt",
    justification = "Installing, removing, or publishing packages requires explicit human approval.",
    match = ["yarn add example"],
)

prefix_rule(
    pattern = ["pip",["install","uninstall"]],
    decision = "prompt",
    justification = "Installing, removing, or publishing packages requires explicit human approval.",
    match = ["pip install example"],
)

prefix_rule(
    pattern = ["pip3",["install","uninstall"]],
    decision = "prompt",
    justification = "Installing, removing, or publishing packages requires explicit human approval.",
    match = ["pip3 install example"],
)

prefix_rule(
    pattern = ["apt",["install","remove","purge"]],
    decision = "prompt",
    justification = "Installing, removing, or publishing packages requires explicit human approval.",
    match = ["apt install example"],
)

prefix_rule(
    pattern = ["apt-get",["install","remove","purge"]],
    decision = "prompt",
    justification = "Installing, removing, or publishing packages requires explicit human approval.",
    match = ["apt-get install example"],
)

# Conservative entry-point checks cover aliases and reordered/attached options.
# Existing forbidden rules take precedence over these approval requirements.
# Prefix rules cannot inspect alias/script bodies or arbitrary shell expansion.
# A wrapper prompt never authorizes a hidden push, migration, or secret access.
# Absolute/renamed executables still depend on host enforcement and review.

prefix_rule(
    pattern = ["git"],
    decision = "prompt",
    justification = "Review Git staging, worktrees, aliases, and global options. Never Push remains absolute; approval cannot authorize a hidden prohibited operation.",
    match = [
        "git add --all",
        "git worktree add /tmp/campusedux-policy-example",
        "git worktree remove /tmp/campusedux-policy-example",
        "git --no-pager status",
        "git -C. status",
        "git --git-dir=.git status",
        "git -c alias.publish=push publish",
    ],
    not_match = ["echo git add ."],
)

prefix_rule(
    pattern = ["npm"],
    decision = "prompt",
    justification = "Review npm commands, aliases, options, and lifecycle scripts before dependency changes or command execution; this includes ci, exec, x, and run.",
    match = [
        "npm ci",
        "npm clean-install",
        "npm ic",
        "npm exec -- example",
        "npm x -- example",
        "npm --prefix=website ci",
        "npm --yes exec -- example",
        "npm run build",
    ],
    not_match = ["echo npm ci"],
)

prefix_rule(
    pattern = [["zsh","dash","ksh","fish","command","builtin","exec","source",".","nohup","timeout","nice","setsid","busybox","time"]],
    decision = "prompt",
    justification = "Review shell and launch wrappers, including their complete arguments and referenced scripts; approval never authorizes hidden prohibited operations.",
    match = [
        "zsh -lc 'git push'",
        "dash -c 'git push'",
        "ksh -c 'git push'",
        "fish -c 'git push'",
        "command git push",
        "builtin eval 'git push'",
        "exec git push",
        "source example.sh",
        ". example.sh",
        "nohup git push",
        "timeout 10 git push",
        "nice git push",
        "setsid git push",
        "busybox sh -c 'git push'",
        "time git push",
    ],
    not_match = ["echo command git push"],
)


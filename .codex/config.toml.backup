# Native CampusEduX project configuration; original Claude configuration is unchanged.
# Neither endpoint may be contacted until the user approves enabling it.

[features]
hooks = false

# Claude per-agent tool allowlists have no equivalent native role field.
# Keep invocation disabled until restrictions and read-only parent usage are reviewed.
[agents]
enabled = false

[mcp_servers.github]
enabled = false
url = "https://api.githubcopilot.com/mcp/"
http_headers = { "X-MCP-Toolsets" = "context,issues,pull_requests,repos,users", "X-MCP-Lockdown" = "true" }

[mcp_servers.supabase]
enabled = false
url = "https://mcp.supabase.com/mcp?project_ref=oqwjooaapsotnncmhvtk&read_only=true&features=database%2Cdocs"

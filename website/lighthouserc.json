{
  "$comment": [
    "Lighthouse CI performance budget for the CampusEduX website.",
    "Runs in .github/workflows/website-ci.yml on pull requests. `npm run build`",
    "already ran in the CI job; this starts `next start` and measures the pages",
    "that render fully WITHOUT Supabase env (the CI build has none) — enough to",
    "protect the shared shell, the JS bundle, compression and image formats from",
    "silent regression. Data-dependent LCP on catalog pages is not covered here;",
    "re-check that on a deployed preview.",
    "",
    "Thresholds: `error` = a real regression guard set at (roughly) today's",
    "numbers + headroom; `warn` = the aspirational target from the perf brief",
    "(LCP < 1.2s etc.) that still needs the nav/session de-Supabase work (B1/B2)."
  ],
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 60000,
      "numberOfRuns": 3,
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/about",
        "http://localhost:3000/premium",
        "http://localhost:3000/resume/templates",
        "http://localhost:3000/compiler",
        "http://localhost:3000/login"
      ],
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "skipAudits": ["uses-http2", "canonical", "redirects-http", "is-on-https"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],

        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2800 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2200 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 500 }],
        "interactive": ["warn", { "maxNumericValue": 4500 }],
        "speed-index": ["warn", { "maxNumericValue": 4000 }],

        "resource-summary:script:size": ["error", { "maxNumericValue": 240000 }],
        "resource-summary:total:size": ["warn", { "maxNumericValue": 420000 }],
        "resource-summary:document:size": ["warn", { "maxNumericValue": 320000 }],

        "uses-text-compression": ["error", { "minScore": 1 }],
        "modern-image-formats": ["warn", { "minScore": 1 }],
        "uses-responsive-images": ["warn", { "minScore": 1 }],
        "render-blocking-resources": ["warn", { "minScore": 1 }],
        "unminified-javascript": ["error", { "minScore": 1 }],
        "unminified-css": ["error", { "minScore": 1 }],
        "efficient-animated-content": ["warn", { "minScore": 1 }],
        "prioritize-lcp-image": ["warn", { "minScore": 1 }],
        "font-display": ["off"]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}

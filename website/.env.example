# --- Supabase (same project the mobile app + admin panel already use) ------
# Public catalog data only (categories, projects, jobs, companies, faqs,
# testimonials, banners, cms_pages, premium_plans, resume_templates,
# custom_project_* catalog, reward_settings) is readable with the anon key
# under the existing RLS policies. Never put the service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://campusedux.app
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Owner-provided (do not fabricate — leave blank until supplied) -------
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_BUSINESS_ADDRESS=
NEXT_PUBLIC_GOVERNING_JURISDICTION=
NEXT_PUBLIC_PLAY_STORE_URL=

# --- Social links (optional — a footer icon renders only when its URL is set) --
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=

# Shared secret for POST /api/revalidate (on-demand Learning cache invalidation
# from the admin panel / a Supabase webhook). Leave blank to disable the endpoint.
REVALIDATE_SECRET=

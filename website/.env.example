# --- Supabase (same project the mobile app + admin panel already use) ------
# Public catalog data only (categories, projects, jobs, companies, faqs,
# testimonials, banners, cms_pages, premium_plans, resume_templates,
# custom_project_* catalog, reward_settings) is readable with the anon key
# under the existing RLS policies. Never put the service-role key in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.campusedux.com
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Owner-provided (do not fabricate — leave blank until supplied) -------
NEXT_PUBLIC_LEGAL_ENTITY_NAME=

# --- WhatsApp Support (optional — sensible defaults are baked into
#     src/lib/whatsapp.ts, so every value below can stay blank) --------------
# Master switch. Anything except off/false/0/no keeps WhatsApp Support visible
# in the footer, Contact, Support and Grievance pages. Set to "off" to hide it
# everywhere at once.
NEXT_PUBLIC_WHATSAPP_SUPPORT=on
# Override the support number (digits only — no "+" or spaces). Default: 919370764290
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=
# Override the pre-filled chat message. Default: the CampusEduX support greeting.
NEXT_PUBLIC_WHATSAPP_SUPPORT_MESSAGE=

# Shared secret for POST /api/revalidate (on-demand Learning cache invalidation
# from the admin panel / a Supabase webhook). Leave blank to disable the endpoint.
REVALIDATE_SECRET=

# --- Résumé AI writing-assist (POST /api/resume/assist) -------------------
# Anthropic API key for the résumé writing-assist feature (used server-side
# only in src/lib/resumeBuilder/aiAssist.ts — never sent to the browser).
# Optional: when unset the assist endpoint returns "AI writing assist isn't
# configured yet." and every other résumé feature keeps working.
ANTHROPIC_API_KEY=

# --- Online code compiler (/compiler + POST /api/compiler/run) -------------
# Also powers the Coding Problem judge (POST /api/coding-problems/judge) — it
# reuses every setting below; there are no extra vars for coding problems.
# Untrusted code is executed only in an external sandbox, reached server-side
# from the API route. No value here is ever sent to the browser.
#
# Default (nothing set): the keyless Paiza.IO guest sandbox — works out of the
# box, but it is rate-limited and offers no SLA. For production, run Judge0
# (self-hosted or RapidAPI) and set COMPILER_PROVIDER=judge0.
# NOTE: the old public Piston API (emkc.org) is whitelist-only since 2026-02-15
# and will 401 — only use COMPILER_PROVIDER=piston with your OWN PISTON_URL.
COMPILER_PROVIDER=paiza                        # paiza | judge0 | piston
PAIZA_URL=https://api.paiza.io                 # override to self-host Paiza (optional)
PAIZA_API_KEY=guest                            # a real Paiza key lifts the guest limits (optional)
JUDGE0_URL=                                    # e.g. https://judge0-ce.p.rapidapi.com  OR  your self-hosted Judge0
JUDGE0_KEY=                                    # RapidAPI key -> X-RapidAPI-Key  (RapidAPI-hosted Judge0 only)
JUDGE0_AUTH_TOKEN=                             # self-hosted Judge0 token -> X-Auth-Token  (alternative to JUDGE0_KEY)
PISTON_URL=                                    # your OWN Piston instance (do NOT use the public emkc.org URL)
COMPILER_REQUIRE_AUTH=false                    # true = only signed-in users may run code
# Optional limit overrides (defaults shown):
# COMPILER_MAX_CODE_BYTES=64000
# COMPILER_MAX_STDIN_BYTES=16000
# COMPILER_TIMEOUT_MS=12000
# COMPILER_RATE_LIMIT_MAX=20
# COMPILER_RATE_LIMIT_WINDOW_MS=60000
